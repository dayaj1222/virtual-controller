# Xbox Controller Proxy — configuration
# Copy this file to .env and edit values.

# Server listen address (default :9449)
LISTEN=:9449

# How often the server batches and flushes events (milliseconds).
# Lower = lower latency but more CPU. 8ms ≈ 125 Hz (original Xbox poll rate).
FLUSH_INTERVAL_MS=8

# Stick deadzone (0.0 – 1.0 normalised). Movements within this range
# from center are treated as zero. Helps with drift on touch screens.
STICK_DEADZONE=0.08

# Trigger analog range: how far (0.0–1.0) before registering as fully pressed.
TRIGGER_THRESHOLD=1.0
